.DS_Store

# Local environment config — secrets, never commit. Template: .env.example
.env

application/cache/*
!application/cache/index.html

application/logs/*
!application/logs/index.html

!application/*/.htaccess

tests/mocks/database/ci_test.sqlite

user_guide_src/build/*
user_guide_src/cilexer/build/*
user_guide_src/cilexer/dist/*
user_guide_src/cilexer/pycilexer.egg-info/*
/vendor/

# database.php is now env-driven (values come from .env, no secrets in
# the file) so it is committed — deployments must not have to hand-edit it.
vendor/

# Public tour photos — user data, never committed. Only the folder's own
# .htaccess (CORS + hardening) is, so every deployment gets it.
/uploads/*
!/uploads/.htaccess

# Protected indoor uploads — contents are user data, never committed
/protected-uploads/*
!/protected-uploads/.gitignore

# IDE Files
#-------------------------
/nbproject/
.idea/*

## Sublime Text cache files
*.tmlanguage.cache
*.tmPreferences.cache
*.stTheme.cache
*.sublime-workspace
*.sublime-project
/tests/tests/
/tests/results/

# PHPUnit
.phpunit.result.cache
