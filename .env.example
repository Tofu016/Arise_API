# Everything that must be set for production is listed in PRODUCTION.md.
#
# Copy this file to .env and fill in real values for the current machine.
# .env is NOT committed to git. Anything set here overrides the hardcoded
# fallbacks in the code.

# development | testing | production
CI_ENV=development
BASE_URL=http://localhost/Arise_API/

# Origin of the front-end allowed to call this API (CORS)
CORS_ORIGIN=http://localhost:5173

# Address of the web app itself, used to build links that point at it (the
# password-reset email). Optional: leave blank to use the first CORS_ORIGIN.
# No trailing slash.
FRONTEND_URL=

# Outgoing email (registration, approval and password-reset messages).
# EMAIL_PROTOCOL=mail uses PHP's own mail(): no extra service, but mail from
# XAMPP or a shared host often lands in spam or never arrives. Set it to smtp
# and fill the EMAIL_SMTP_* values to use a real mail server instead.
EMAIL_PROTOCOL=mail
EMAIL_FROM=noreply@sdca.edu.ph
EMAIL_FROM_NAME="ARISE Campus Navigator"
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_SMTP_CRYPTO=tls

# Database
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=arise_web

# Upload directories. Blank UPLOAD_ROOT means this project's own uploads/;
# blank PROTECTED_UPLOAD_ROOT means protected-uploads/ two directories above
# index.php (outside htdocs on XAMPP), not one inside the project. If set, use an ABSOLUTE path
# WITH a trailing slash, e.g. /var/www/arise-uploads/
UPLOAD_ROOT=
PROTECTED_UPLOAD_ROOT=
