# Copy this file to .env and fill in real values for the current machine.
# .env is NOT committed to git. Anything set here overrides the hardcoded
# fallbacks in the code.

# development | testing | production
CI_ENV=development
BASE_URL=http://localhost/Arise_API/

# Origin of the front-end allowed to call this API (CORS)
CORS_ORIGIN=http://localhost:5173

# Database
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=arise_web

# Upload directories. Leave blank to use the in-project defaults
# (uploads/ and protected-uploads/). If set, use an ABSOLUTE path
# WITH a trailing slash, e.g. /var/www/arise-uploads/
UPLOAD_ROOT=
PROTECTED_UPLOAD_ROOT=

# Outgoing email (used by Cron_API processEmails, CLI only)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=noreply@sdca.edu.ph
SMTP_FROM_NAME="ARISE Campus Navigator"

# Error tracking (optional, used later)
SENTRY_DSN=
